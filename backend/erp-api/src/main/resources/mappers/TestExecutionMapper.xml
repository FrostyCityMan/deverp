<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.deverp.core.mapper.TestExecutionMapper">
  <select id="findByTestCaseId" resultType="TestExecution">
    SELECT * FROM test_execution WHERE test_case_id = #{testCaseId}
  </select>

  <select id="findById" resultType="TestExecution">
    SELECT * FROM test_execution WHERE id = #{id}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO test_execution (
      test_case_id, tester_id, actual_result, passed, executed_at, attachment_id
    ) VALUES (
      #{testCaseId}, #{testerId}, #{actualResult}, #{passed}, #{executedAt}, #{attachmentId}
    )
  </insert>

  <delete id="delete">
    DELETE FROM test_execution WHERE id = #{id}
  </delete>
</mapper>
